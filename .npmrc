# Sem isso, pnpm pede confirmação interativa (via TTY) antes de recriar node_modules quando
# detecta mudanças relevantes de lockfile/workspace. Rodando o deploy via `curl | bash` não há
# TTY pra responder, e o install trava com ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY.
confirm-modules-purge=false
