DATABASE_URL="postgresql://cc_app:cc_app_pw@localhost:5432/creditcard_dev?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3333
WEB_ORIGIN="http://localhost:5173"

# Criação de contas novas. Sem esta variável, o cadastro fica aberto SÓ enquanto não existe nenhum
# usuário — a instalação nova cria o dono e se fecha sozinha. Depois disso é preciso ligar aqui de
# propósito. Num app pessoal exposto na internet, cadastro aberto é alguém entrando autenticado e
# explorando a API por dentro.
ALLOW_REGISTRATION="true"

# Web Push (notificações no iPhone/Android) — gere um par com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Sem essas duas chaves, PushService.getPublicKey() retorna null e o frontend simplesmente
# esconde a opção de ativar notificações (nunca falha silenciosamente).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:seu-email@example.com"

# WebAuthn (Face ID/Touch ID) — exige HTTPS (ou localhost) e RP_ID igual ao hostname exato
# servido para o navegador, sem esquema/porta (ex: "app.exemplo.com", nunca "https://app.exemplo.com").
RP_ID="localhost"
RP_NAME="Ferramentas do Mauro"
RP_ORIGIN="http://localhost:5173"

# Assistente de chat (console.anthropic.com) — sem essa chave, AssistantService.chat() responde
# 503 e o frontend mostra que a feature não está configurada, nunca falha silenciosamente.
ANTHROPIC_API_KEY=""

# Voz do assistente via ElevenLabs (elevenlabs.io) — opcional, upgrade pago sobre a leitura em voz
# alta grátis do navegador. Sem essa chave, GET /assistant/voices e POST /assistant/speak respondem
# 503 e o frontend some com a opção ElevenLabs no seletor de voz, mantendo só as vozes do navegador.
ELEVENLABS_API_KEY=""
